{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CCL",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-O2",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-Isrc",
                "src/ccl_main.c",
                "src/lexer.c",
                "src/parser.c",
                "src/emit.c",
                "src/vm.c",
                "-o",
                "ccl.exe"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}